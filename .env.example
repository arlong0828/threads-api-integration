# Meta Threads API credentials
# 1) Create a Meta Developer App
# 2) Add Threads API use case/product
# 3) Set OAuth redirect URI exactly to the same value below in the app settings
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8787/callback

# Optional: set manually instead of token.json
# THREADS_ACCESS_TOKEN=

# Optional: avoid putting the one-time OAuth code in shell history
# THREADS_OAUTH_CODE=
